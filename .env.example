# Configure as variaveis na Vercel (Production e Preview conforme necessario).
# Nunca use NEXT_PUBLIC_ para senhas, service_role ou tokens de pagamento.
SITE_URL=https://seu-dominio-publico
NEXTAUTH_URL=https://seu-dominio-publico
NEXTAUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_USER=
EMAIL_PASS=
# Opcional: quando vazio, as notificacoes do admin usam EMAIL_USER.
ADMIN_EMAIL=
# E-mail publico de atendimento (pode ser a caixa que voce ja utiliza).
NEXT_PUBLIC_CONTACT_EMAIL=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
CRON_SECRET=
# Integracoes existentes; mantenha seus valores se ainda forem usadas.
RESEND_API_KEY=
MELHOR_ENVIO_TOKEN=

# CEP real da expedição (oito dígitos); obrigatório para cotar frete.
CEP_ORIGEM=

# Mesmo ambiente do token: production (padrão) ou sandbox.
MELHOR_ENVIO_AMBIENTE=production
# Config JSON privado. CEP vem de CEP_ORIGEM; email usa EMAIL_USER quando omitido.
# Use o nome civil do titular para CPF ou a razão social para CNPJ, com os dados reais de expedição.
# {"nome":"Nome do titular ou empresa","documento":"CPF_OU_CNPJ_SO_NUMEROS","telefone":"DDD_TELEFONE","logradouro":"Rua","numero":"123","complemento":"","bairro":"Bairro","cidade":"Cidade","uf":"SC","inscricao_estadual":"SE_HOUVER"}
MELHOR_ENVIO_REMETENTE=
# Medidas REAIS por unidade embalada: cm e kg. O pacote do pedido soma altura/peso.
MELHOR_ENVIO_LARGURA_CM=11
MELHOR_ENVIO_ALTURA_CM=3
MELHOR_ENVIO_COMPRIMENTO_CM=16
MELHOR_ENVIO_PESO_KG=0.15
# Opcional: IDs dos serviços habilitados, separados por vírgula. Vazio consulta todos.
MELHOR_ENVIO_SERVICOS=
